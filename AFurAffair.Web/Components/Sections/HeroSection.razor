@inject ISalonInfoService Salon

<header class="hero">
    <div class="hero-content">
        <div class="hero-eyebrow">Now booking · Kearns, UT</div>
        <h1 class="display">Spa days for the <em>goodest</em> good boys &amp; girls.</h1>
        <p class="lead">Gentle, expert grooming from Cesar and the team. Bath, brush, full grooms, teeth cleaning, and daycare — all in one neighborhood spot.</p>
        <div class="hero-ctas">
            <a href="@Salon.MoeGoBookingUrl" target="_blank" rel="noopener" class="btn btn-primary">
                Book online <span class="arrow">→</span>
            </a>
            <a href="tel:@Salon.PhoneTel" class="btn btn-ghost">
                📞 @Salon.Phone
            </a>
        </div>
        <div class="hero-stats">
            <div><div class="stat-num">88%</div><div class="stat-label">Recommend us</div></div>
            <div><div class="stat-num">61+</div><div class="stat-label">5-star reviews</div></div>
            <div><div class="stat-num">10+</div><div class="stat-label">Years in Kearns</div></div>
        </div>
    </div>
    <div class="hero-art">
        <div class="hero-monogram">
            <div class="monogram-circle">
                <span class="monogram-text">AFA</span>
            </div>
        </div>
        <div class="badge badge-tr">
            <span>✨</span>
            <span>Just groomed!</span>
        </div>
        <div class="badge badge-bl">
            <span>🦴</span>
            <span>Treats included</span>
        </div>
    </div>
</header>
