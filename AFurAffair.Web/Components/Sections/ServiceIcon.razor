@* Inline SVG icons so we don't depend on an icon font *@
@switch (Name)
{
    case "tooth":
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 5.5C9.5 3 6 3.5 5 6.5c-1 3 .5 6 1 9 .5 2 2 5.5 3.5 5.5s2-2 2.5-5c.5 3 1 5 2.5 5s3-3.5 3.5-5.5c.5-3 2-6 1-9-1-3-4.5-3.5-7-1z" />
        </svg>
        break;
    case "scissors":
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="6" cy="6" r="3" /><circle cx="6" cy="18" r="3" />
            <line x1="20" y1="4" x2="8.12" y2="15.88" /><line x1="14.47" y1="14.48" x2="20" y2="20" />
            <line x1="8.12" y1="8.12" x2="12" y2="12" />
        </svg>
        break;
    case "bath":
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 6 8 4l-2 1 1 2" /><path d="M2 12h20v3a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4v-3z" />
            <path d="M7 19v2M17 19v2" />
        </svg>
        break;
    case "paw":
        <svg viewBox="0 0 24 24" fill="currentColor">
            <circle cx="5.5" cy="9" r="1.8" /><circle cx="9.5" cy="5" r="1.8" />
            <circle cx="14.5" cy="5" r="1.8" /><circle cx="18.5" cy="9" r="1.8" />
            <path d="M12 11c-3.5 0-6 3-6 5.5 0 2 1.5 3 3 3 1 0 1.8-.6 3-.6s2 .6 3 .6c1.5 0 3-1 3-3 0-2.5-2.5-5.5-6-5.5z" />
        </svg>
        break;
    case "shed":
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 21v-2a4 4 0 0 1 4-4h6a4 4 0 0 1 4 4v2" />
            <circle cx="10" cy="7" r="4" />
            <path d="M18 4l3 3M21 4l-3 3M18 11l3 3M21 11l-3 3" />
        </svg>
        break;
    case "drop":
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z" />
        </svg>
        break;
    default:
        <svg viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="6" /></svg>
        break;
}

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
}
